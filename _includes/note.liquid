<div class="document-entry">
  
  <h3>{{ include.doc.title | escape }}</h3>

  {% if include.doc.pdf %}
    <a href="{{ include.doc.pdf | relative_url }}"
       target="_blank" rel="noopener"
       title="Open PDF" aria-label="Open PDF">
      <img src="{{ '/assets/img/pdf.ico' | relative_url }}"
           alt=""
           style="width: 1.25rem; height: 1.25rem; vertical-align: middle;">
    </a>
  {% endif %}

  {% if include.doc.github %}
    <a href="{{ include.doc.github | escape }}"
       target="_blank" rel="noopener"
       title="View on GitHub" aria-label="View on GitHub">
       <img src="{{ '/assets/img/github.ico' | relative_url }}"
           alt=""
           style="width: 1.25rem; height: 1.25rem; vertical-align: middle;">
    </a>
  {% endif %}

  {% if include.doc.matlab %}
    <a href="{{ include.doc.matlab | escape }}"
       target="_blank" rel="noopener"
       title="View MATLAB code" aria-label="View MATLAB code">
      <img src="{{ '/assets/img/matlab.ico' | relative_url }}"
           alt=""
           style="width: 1.25rem; height: 1.25rem; vertical-align: middle;">
    </a>
  {% endif %}

  {% if include.doc.abstract %}
    <details class="document-abstract">
      <summary>Abstract</summary>
      {{ include.doc.abstract | markdownify }}
    </details>
  {% endif %}

</div>